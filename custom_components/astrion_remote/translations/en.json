{
  "config": {
    "step": {
      "user": {
        "title": "Astrion Remote",
        "description": "Add one Astrion remote. It talks to Home Assistant only over MQTT.",
        "data": {
          "device_id": "Device id",
          "base_topic": "Base topic"
        },
        "data_description": {
          "device_id": "Id of the remote, as configured in the app (for example ha100).",
          "base_topic": "MQTT base topic of the remote (for example astrion/ha100)."
        }
      }
    },
    "error": {
      "invalid_device_id": "Use lowercase letters, digits, _ or - only.",
      "invalid_topic": "Invalid topic: no wildcards (+ #), no leading slash, no empty levels."
    },
    "abort": {
      "already_configured": "This remote is already configured.",
      "mqtt_not_configured": "Set up the MQTT integration first."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Astrion Remote",
        "menu_options": {
          "keys": "Keys",
          "pages": "Pages",
          "timings": "Timings & theme",
          "yaml": "Import/export full config (YAML)"
        }
      },
      "keys": {
        "title": "Keys",
        "description": "Pick a key, a gesture and what it should do. Every press also fires the astrion_remote_button event.",
        "data": {
          "key": "Key",
          "gesture": "Gesture",
          "action_type": "Action type"
        }
      },
      "key_ha": {
        "title": "Home Assistant action",
        "description": "Action for {key} ({gesture}). Target entities only; the allowlist is updated automatically. {error}",
        "data": {
          "action": "Action",
          "repeat": "Repeat while held"
        }
      },
      "key_tv_key": {
        "title": "TV key",
        "description": "TV key for {key} ({gesture}), sent straight to Control Freak.",
        "data": {
          "tv_key": "Key name (e.g. DPAD_CENTER)",
          "hold": "When held"
        }
      },
      "key_page": {
        "title": "Page",
        "description": "Page for {key} ({gesture}).",
        "data": {
          "page": "Page"
        }
      },
      "key_app": {
        "title": "App command",
        "description": "Local app command for {key} ({gesture}).",
        "data": {
          "cmd": "Command"
        }
      },
      "pages": {
        "title": "Pages",
        "description": "Edit the pages (YAML list). {error}",
        "data": {
          "pages": "Pages"
        }
      },
      "timings": {
        "title": "Timings & theme",
        "data": {
          "hold_ms": "Hold threshold",
          "double_ms": "Double-tap window",
          "keepalive_ms": "Hold repeat interval",
          "theme_mode": "Theme",
          "calm": "Calm mode",
          "keytopic": "TV key topic",
          "context_entity": "TV context entity",
          "apk_dir": "APK sub directory",
          "base_url": "Home Assistant URL reachable from the remote"
        },
        "data_description": {
          "apk_dir": "Folder under /config/astrion_remote/ holding astrion-<version>.apk and its .sha256. Empty = that folder itself.",
          "base_url": "Used for the one-time APK download link, e.g. http://192.168.5.166:8123 (no path). Empty = Home Assistant's internal URL.",
          "context_entity": "Entity whose state picks key contexts (current TV app)."
        }
      },
      "yaml": {
        "title": "Import/export",
        "description": "Copy the full config, or paste a new one and submit. The allowlist is always recomputed. {error}",
        "data": {
          "config": "Config (YAML)"
        }
      }
    },
    "error": {
      "invalid_action": "Invalid action.",
      "invalid_pages": "The pages do not match the schema.",
      "invalid_yaml": "Not valid YAML.",
      "invalid_config": "The config does not match the schema.",
      "invalid_apk_dir": "Use a relative folder without '..'.",
      "invalid_base_url": "Use http(s)://host[:port] without a path.",
      "invalid_timings": "Invalid values."
