{
 "schema_version": 1,
 "timings": {
  "hold_ms": 450,
  "double_ms": 350,
  "keepalive_ms": 300
 },
 "tv": {
  "keytopic": "controlfreak/hisense_tv/key/set",
  "context_entity": "sensor.hisense_tv_current_app"
 },
 "theme": {
  "mode": "auto",
  "calm": false
 },
 "keys": {
  "up": {
   "tap": {
    "type": "tv_key",
    "key": "DPAD_UP",
    "hold": "passthrough"
   }
  },
  "down": {
   "tap": {
    "type": "tv_key",
    "key": "DPAD_DOWN",
    "hold": "passthrough"
   }
  },
  "left": {
   "tap": {
    "type": "tv_key",
    "key": "DPAD_LEFT",
    "hold": "passthrough"
   }
  },
  "right": {
   "tap": {
    "type": "tv_key",
    "key": "DPAD_RIGHT",
    "hold": "passthrough"
   }
  },
  "ok": {
   "tap": {
    "type": "tv_key",
    "key": "DPAD_CENTER",
    "hold": "passthrough"
   }
  },
  "back": {
   "tap": {
    "type": "tv_key",
    "key": "BACK",
    "hold": "passthrough"
   }
  },
  "menu": {
   "tap": {
    "type": "tv_key",
    "key": "MENU",
    "hold": "passthrough"
   }
  },
  "vol_up": {
   "tap": {
    "type": "ha",
    "action": "script.turn_on",
    "target": {
     "entity_id": [
      "script.stereo_volume_up"
     ]
    }
   },
   "hold": {
    "type": "ha",
    "action": "script.turn_on",
    "target": {
     "entity_id": [
      "script.stereo_volume_up"
     ]
    },
    "repeat": true
   }
  },
  "vol_down": {
   "tap": {
    "type": "ha",
    "action": "script.turn_on",
    "target": {
     "entity_id": [
      "script.stereo_volume_down"
     ]
    }
   },
   "hold": {
    "type": "ha",
    "action": "script.turn_on",
    "target": {
     "entity_id": [
      "script.stereo_volume_down"
     ]
    },
    "repeat": true
   }
  },
  "mute": {
   "tap": {
    "type": "ha",
    "action": "button.press",
    "target": {
     "entity_id": [
      "button.stereo_volume_mute"
     ]
    }
   }
  },
  "page_up": {
   "tap": {
    "type": "page",
    "page": "prev"
   }
  },
  "page_down": {
   "tap": {
    "type": "page",
    "page": "next"
   }
  },
  "red": {
   "tap": {
    "type": "ha",
    "action": "select.select_next",
    "target": {
     "entity_id": [
      "select.phoster_subtitles"
     ]
    },
    "data": {
     "cycle": true
    }
   }
  },
  "green": {
   "tap": {
    "type": "ha",
    "action": "select.select_next",
    "target": {
     "entity_id": [
      "select.phoster_audio_track"
     ]
    },
    "data": {
     "cycle": true
    }
   }
  },
  "yellow": {
   "tap": {
    "type": "ha",
    "action": "input_select.select_next",
    "target": {
     "entity_id": [
      "input_select.light_scenes"
     ]
    },
    "data": {
     "cycle": true
    }
   }
  },
  "blue": {
   "tap": {
    "type": "ha",
    "action": "select.select_next",
    "target": {
     "entity_id": [
      "select.hisense_tv_picture_mode"
     ]
    },
    "data": {
     "cycle": true
    }
   }
  },
  "home": {
   "tap": {
    "type": "page",
    "page": "now"
   },
   "double": {
    "type": "tv_key",
    "key": "HOME",
    "hold": "none"
   }
  },
  "power": {
   "tap": {
    "type": "event"
   }
  },
  "voice": {
   "tap": {
    "type": "voice",
    "target": "ha"
   },
   "hold": {
    "type": "voice",
    "target": "tv"
   }
  },
  "sc1": {
   "tap": {
    "type": "none"
   }
  },
  "sc2": {
   "tap": {
    "type": "none"
   }
  },
  "sc3": {
   "tap": {
    "type": "none"
   }
  },
  "sc4": {
   "tap": {
    "type": "none"
   }
  }
